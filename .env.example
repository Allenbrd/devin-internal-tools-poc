# Copied to .env by `npm run db:setup` if .env does not exist.
# Nothing in here is a real secret; never commit .env.

# SQLite file, relative to prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Identity provider used by src/platform/auth. Only "mock" exists today.
AUTH_PROVIDER="mock"

# HMAC key for the platform session cookie (>= 32 chars). Dev-only value.
SESSION_SECRET="dev-only-insecure-session-secret-change-me-0123456789"

# The mock provider refuses to run when NODE_ENV=production unless this is "true"
# (e.g. for `next start` smoke tests). Never set it in a real deployment.
ALLOW_MOCK_AUTH="false"

# Refunds app: amount (major units, any currency) at or above which a refund
# needs two approvals from two different approvers. Default 500.
REFUND_DUAL_APPROVAL_THRESHOLD="500"
