// Local development uses SQLite; production targets Postgres.
// Keep this schema portable: no enums, no native type attributes (@db.*),
// no provider-specific defaults. CI validates it against Postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Platform user. `externalId` is the identity-provider subject
/// (mock: the seed key; Entra ID: the `oid` claim).
model User {
  id         String   @id @default(cuid())
  externalId String   @unique
  email      String   @unique
  name       String
  /// One of: viewer | operator | approver | admin. Stored as text (not an enum)
  /// for portability; unknown values are denied everything at runtime.
  role       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  refundsRequested Refund[]
  refundDecisions  RefundDecision[]
}

/// Append-only audit trail. Never updated or deleted: guarded in the Prisma
/// client (src/platform/db) and by database triggers (prisma/sql/*).
/// Actor fields are denormalised on purpose so events survive user changes.
model AuditEvent {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  actorId      String?
  actorEmail   String
  actorRole    String
  /// Dotted verb, e.g. "customer.update", "sensitive.unmask", "access.denied".
  action       String
  /// "success" | "denied"
  outcome      String
  resourceType String?
  resourceId   String?
  /// JSON snapshots with sensitive fields masked. Stored as text for portability.
  before       String?
  after        String?
  /// JSON object with extra context (permission checked, fields read, ...).
  metadata     String?

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@index([resourceType, resourceId])
}

/// Sample app data (Customer Directory).
model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  /// Sensitive: masked by default, see src/apps/customers/sensitive.ts
  iban      String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refunds Refund[]
}

/// Refunds app. Amounts are integer minor units (cents) to avoid float/decimal
/// portability issues; all supported currencies have 2 decimals.
model Refund {
  id                String   @id @default(cuid())
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id])
  amountMinor       Int
  /// ISO 4217 code, see src/apps/refunds/policy.ts
  currency          String
  reason            String
  /// Optional below 500, required at 500+: duplicate_charge | not_received | goodwill | fraud
  /// (see src/apps/refunds/policy.ts). Null on refunds requested without one.
  reasonCode        String?
  /// Sensitive: masked by default, see src/apps/refunds/sensitive.ts
  destinationIban   String
  /// One of: requested | approved | rejected | paid
  status            String   @default("requested")
  /// Approvals needed, fixed when the refund is requested (four-eyes threshold).
  requiredApprovals Int
  requestedById     String
  requestedBy       User     @relation(fields: [requestedById], references: [id])
  /// Optimistic concurrency token; bumped on every state change.
  version           Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  decisions RefundDecision[]

  @@index([status])
  @@index([reasonCode])
  @@index([requestedById])
}

/// One approve/reject decision per approver per refund (enforced by the unique key).
model RefundDecision {
  id         String   @id @default(cuid())
  refundId   String
  refund     Refund   @relation(fields: [refundId], references: [id])
  approverId String
  approver   User     @relation(fields: [approverId], references: [id])
  /// "approve" | "reject"
  decision   String
  note       String?
  createdAt  DateTime @default(now())

  @@unique([refundId, approverId])
}

/// Feature-flag admin: one row per flag key per environment.
model FeatureFlag {
  id             String              @id @default(cuid())
  key            String
  description    String
  /// One of: dev | staging | prod (validated in src/apps/flags/data.ts).
  environment    String
  enabled        Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  changeRequests FlagChangeRequest[]

  @@unique([key, environment])
}

/// A requested toggle of a flag in an approval-gated environment (prod).
/// The flag only changes when an approver other than the requester approves.
model FlagChangeRequest {
  id               String      @id @default(cuid())
  flagId           String
  flag             FeatureFlag @relation(fields: [flagId], references: [id])
  /// Target state, applied on approval.
  enabled          Boolean
  reason           String
  /// One of: pending | approved | rejected.
  status           String      @default("pending")
  /// Equals flagId while pending, null once decided: at most one pending request per flag
  /// (portable alternative to a partial unique index; NULLs never collide).
  pendingFlagId    String?     @unique
  requestedById    String
  requestedByEmail String
  decidedById      String?
  decidedByEmail   String?
  decidedAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([flagId, createdAt])
  @@index([status])
}
